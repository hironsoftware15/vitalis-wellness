require "base64"
default_platform(:ios)

platform :ios do
  desc "Build and upload Vitalis to App Store Connect"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    keychain_name = "ci_keychain"
    keychain_password = "vitalis_build_pass"
    keychain_full_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    delete_keychain(name: keychain_name) if File.exist?(keychain_full_path)

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Import the permanent Apple Distribution Certificate & Private Key (.p12)
    p12_path = "/tmp/vitalis_dist.p12"
    File.write(p12_path, Base64.decode64(ENV["CERT_P12_BASE64"]))
    import_certificate(
      keychain_name: keychain_name,
      keychain_path: keychain_full_path,
      keychain_password: keychain_password,
      certificate_path: p12_path,
      certificate_password: "vitalis_build_pass"
    )

    team_id = "RMX4QDBMGY"

    # Fetch/install the App Store Provisioning Profile using API Key
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.vitalis.wellness",
      team_id: team_id
    )

    profile_name = lane_context[SharedValues::SIGH_NAME] || ENV["SIGH_NAME"]
    profile_uuid = lane_context[SharedValues::SIGH_UDID] || ENV["SIGH_UUID"]

    # Explicitly configure Manual code signing for Release with the App Store profile
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Vitalis.xcodeproj",
      team_id: team_id,
      bundle_identifier: "com.vitalis.wellness",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      build_configurations: ["Release"]
    )

    build_app(
      project: "Vitalis.xcodeproj",
      scheme: "Vitalis",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.vitalis.wellness" => profile_name
        }
      },
      output_directory: "./build",
      output_name: "Vitalis.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.vitalis.wellness",
      ipa: "./build/Vitalis.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
