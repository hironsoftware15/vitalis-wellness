<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>NexVital</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.vitalis.wellness</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>NexVital</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    
    <!-- Supported Interface Orientations for iPhone and iPad Multitasking -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    
    <!-- Export Compliance: No Non-Exempt Encryption -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    
    <!-- Apple HealthKit Privacy Usage Descriptions (Strictly Required for App Store Approval) -->
    <key>NSHealthShareUsageDescription</key>
    <string>NexVital reads your daily steps, heart rate variability (HRV), resting heart rate, active calories, and sleep stages from Apple Watch and Apple Health to calculate your personalized Longevity Readiness Score and provide circadian wellness coaching.</string>
    
    <key>NSHealthUpdateUsageDescription</key>
    <string>NexVital can write completed workouts and hydration entries back to Apple HealthKit so your health record stays synchronized across your Apple ecosystem.</string>
    
    <!-- Camera Usage Description for Multimodal AI Meal Scanning -->
    <key>NSCameraUsageDescription</key>
    <string>NexVital requires camera access to scan meals and analyze macronutrient distribution using Gemini vision intelligence.</string>
    
    <!-- Background Modes -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
        <string>fetch</string>
    </array>
    
    <!-- App Transport Security -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>
    
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
</dict>
</plist>
